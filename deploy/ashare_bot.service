[Unit]
Description=A股行情监控 Telegram Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ashare
Group=ashare
WorkingDirectory=/opt/ashare_monitor
ExecStart=/opt/ashare_monitor/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
EnvironmentFile=-/etc/ashare-monitor/ashare.env
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ashare_monitor
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
