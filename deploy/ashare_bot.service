[Unit]
Description=A股行情监控 Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ashare_monitor
ExecStart=/opt/ashare_monitor/venv/bin/python bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
