[Unit]
Description=A股与全球基准指数行情采集器
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ashare
Group=ashare
WorkingDirectory=/opt/ashare_monitor
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Shanghai
EnvironmentFile=/etc/ashare-monitor/ashare.env
ExecStart=/opt/ashare_monitor/venv/bin/python market_monitor.py
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ashare_monitor
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
