[Unit]
Description=A股监控 SQLite 在线备份
After=ashare_monitor.service ashare_market_monitor.service ashare_bot.service ashare_web.service

[Service]
Type=oneshot
User=ashare
Group=ashare
WorkingDirectory=/opt/ashare_monitor
Environment=TZ=Asia/Shanghai
EnvironmentFile=-/etc/ashare-monitor/ashare.env
ExecStart=/opt/ashare_monitor/venv/bin/python backup_database.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ashare_monitor /var/backups/ashare-monitor
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
