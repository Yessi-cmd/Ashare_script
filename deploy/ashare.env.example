# 安装为 /etc/ashare-monitor/ashare.env，权限必须为 0600。
ASHARE_CONFIG_PATH=/opt/ashare_monitor/config.yaml
ASHARE_DATABASE_URL=sqlite:////opt/ashare_monitor/ashare_monitor.db
ASHARE_WEB_USERNAME=replace-with-personal-username
ASHARE_WEB_PASSWORD=replace-with-a-long-random-password
ASHARE_WEB_SESSION_SECRET=replace-with-at-least-32-random-bytes
# 留空则关闭网页注册；分享给朋友时填写长随机邀请码
ASHARE_WEB_REGISTRATION_CODE=replace-with-a-long-random-invite-code
ASHARE_BACKUP_DIR=/var/backups/ashare-monitor
ASHARE_BACKUP_RETENTION_DAYS=14
